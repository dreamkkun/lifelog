# [Required] Supabase Project Credentials (Client & Server Side)
# Vercel: Settings → Environment Variables → Production / Preview / Development 모두 체크
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 주의: Service Role Key 는 이 앱에서 쓰지 않으며, 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.

# (선택) Supabase 에서 Google 로그인 공급자를 설정한 뒤에만 true 로 바꾸세요.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
