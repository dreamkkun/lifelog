# [Required] Supabase Project Credentials (Client & Server Side)
# Vercel: Settings → Environment Variables → Production / Preview / Development 모두 체크
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 주의: Service Role Key 는 저녁 알림 예약 발송(/api/push/send)에서만 서버가 쓰며, 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.

# (선택) Supabase 에서 Google 로그인 공급자를 설정한 뒤에만 true 로 바꾸세요.
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# (선택) 독서 기록의 책 표지 촬영/제목 검색용 Google Books API 키. 없어도 동작하지만 무료 공용 한도가 자주 소진돼 검색이 막힐 수 있어요.
# Google Cloud 콘솔에서 Books API 를 켜고 API 키를 만든 뒤 Vercel 환경 변수로 넣으세요 (NEXT_PUBLIC_ 접두사 금지).
GOOGLE_BOOKS_API_KEY=

# (선택) 저녁 미입력 푸시 알림. `npm run vapid` 로 값을 만들어 Vercel 환경 변수에 넣으세요. 모두 서버 전용이며 PUBLIC 키만 NEXT_PUBLIC_ 입니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
